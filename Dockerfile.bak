# =========================
# Stage 1: Build frontend
# =========================
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY investment_frontend/package*.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund
COPY investment_frontend/ ./
# Remove the existing edit_data route that conflicts with our catch-all
RUN rm -rf src/app/api/edit_data
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx next build --no-lint 2>&1 || (echo "Attempting build without ESLint plugin..." && DISABLE_ESLINT_PLUGIN=true npx next build 2>&1)

# =========================
# Stage 2: Final image
# =========================
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies and Python packages in one layer to save space
COPY investment_backend/requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc git curl postgresql-client nodejs \
    && pip install --default-timeout=1000 --no-cache-dir -r requirements.txt \
    && playwright install chromium \
    && playwright install-deps chromium \
    && apt-get purge -y --auto-remove build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy backend code
COPY investment_backend/ ./backend

# Copy frontend standalone build
# Standalone mode puts everything needed in .next/standalone
COPY --from=frontend-build /app/frontend/.next/standalone ./frontend
COPY --from=frontend-build /app/frontend/.next/static ./frontend/.next/static
COPY --from=frontend-build /app/frontend/public ./frontend/public

# Copy entrypoint script
COPY investment_backend/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose ports
EXPOSE 3337 3000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

ENTRYPOINT ["./entrypoint.sh"]